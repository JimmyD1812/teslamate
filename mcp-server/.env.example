# Copy to .env on the host and fill in real values there.
# NEVER commit a filled-in .env to git.

# PostgreSQL connection for the TeslaMate database.
# Use the dedicated read-only user created by sql/create_readonly_user.sql.
TESLAMATE_DB_HOST=database
TESLAMATE_DB_PORT=5432
TESLAMATE_DB_NAME=teslamate
TESLAMATE_DB_USER=teslamate_mcp
TESLAMATE_DB_PASSWORD=change-me

# Port the MCP server listens on inside the container/host network.
MCP_PORT=8765

# Shared secret required in the Authorization: Bearer header of every
# request. Generate a long random value at install time, e.g.
#   openssl rand -hex 32
# The same value is configured on the client (Muse connector) side.
MCP_AUTH_TOKEN=change-me-too
