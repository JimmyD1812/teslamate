# Command gateway configuration. Copy to .env on the host and fill in real
# values there. NEVER commit a filled-in .env to git.

# Kill switch. Must be exactly "true" for any tool to run. Anything else
# (including unset) means every command is refused and logged.
GATEWAY_ENABLED=false

# The gateway's OWN bearer token for its MCP endpoint (separate from the
# TeslaMate MCP server's token). Generate: openssl rand -hex 32
GATEWAY_AUTH_TOKEN=change-me
GATEWAY_PORT=8766

# The ONE car this gateway may talk to. Tools accept no vehicle parameter.
TESLA_VIN=5YJ...

# Tesla developer application credentials (from developer.tesla.com).
# Used only to refresh the OAuth access token.
TESLA_CLIENT_ID=change-me
TESLA_CLIENT_SECRET=change-me

# Where the OAuth tokens live (written by scripts/get_tokens.py, refreshed
# automatically by the gateway) and where the audit log is appended.
TESLA_TOKEN_FILE=/data/tokens.json
GATEWAY_AUDIT_LOG=/data/audit.log

# Local Tesla vehicle-command proxy (signs commands with the developer
# private key). Default assumes the proxy service name from
# docker-compose.example.yml on the same container network.
TESLA_PROXY_BASE_URL=https://tesla-http-proxy:4443

# Wake the car before starting climate (it cannot start climate asleep).
WAKE_BEFORE_CLIMATE=true
